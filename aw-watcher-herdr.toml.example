# Copy to your ActivityWatch config directory, which on macOS is:
#   ~/Library/Application Support/activitywatch/aw-watcher-herdr/aw-watcher-herdr.toml
# CLI flags override these values.

[aw-watcher-herdr]
# How to reach herdr. "auto" reads the Herdr native app whenever its window
# is open and falls back to the Herdr TUI's Unix socket otherwise (macOS and
# Linux); on Windows it uses the TUI's `herdr api snapshot` CLI, because
# herdr uses named pipes there. "app", "socket" and "cli" force one of them.
source = "auto"                # nothing but auto, app, socket or cli is accepted

# Socket source (the TUI) only. Defaults to ~/.config/herdr/herdr.sock, and a
# leading ~ is expanded here too.
# socket_path = "~/.config/herdr/herdr.sock"

# App source only. Both default to where herdr-app and herdr-core put their
# sockets, honouring HERDR_APP_HOME, HC_SOCKET, HC_SESSION and XDG_RUNTIME_DIR
# the way those programs do. Set core_socket_path if your herdr-core
# config.toml sets a custom `socket`.
# app_socket_path = "~/.config/herdr-app/herdr-app.sock"
# core_socket_path = "/run/user/1000/herdr-core/default.sock"

# CLI source only: the herdr executable to invoke.
herdr_binary = "herdr"

poll_interval = 2.0            # seconds between snapshots, must be > 0
pulsetime = 5.0                # heartbeat merge window (attention bucket), must be > 0
generic_terminal_label = "terminal"   # title for panes with no agent

# --- agent fleet bucket ---
fleet_enabled = true
# Which herdr agent states become intervals. `idle` is the resting state and
# would dwarf everything else; `unknown` (TUI) does not prove completion.
# `error` is reported by herdr-core only: the program stopped on a fault and
# needs a person, so it is tracked like `blocked`.
fleet_statuses = ["working", "blocked", "done", "error"]
max_run_seconds = 43200.0      # hard cap on one run (12h), guards a wedged watcher, must be > 0
gap_factor = 3.0               # gap > gap_factor x poll_interval => machine slept.
                               # Must be > 1: at or below 1 every normal poll counts
                               # as a gap and the fleet bucket stays empty.

# --- used by --print-query ---
# The window herdr is in, as your window watcher names it: the native app's
# own window (`herdr-app` on Linux, `Herdr` on macOS) or the terminal you run
# the TUI in, which differs per platform. Run `aw-watcher-herdr
# --detect-terminal` to find yours. A list, because you may use both.
window_app = ["Ghostty", "Herdr"]
# Optional regex narrowing on the window title.
# window_title = "herdr"
